{
  "file_scan_exclusions": [
    "**/.DS_Store",
    "**/node_modules",
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.mypy_cache",
    "**/.ruff_cache"
  ],
  "languages": {
    "Python": {
      "language_servers": ["ruff", "basedpyright", "!ty", "!pyright", "!pylsp"],
      "format_on_save": "on",
      "formatter": [
        {
          "code_actions": {
            "source.organizeImports.ruff": true,
            "source.fixAll.ruff": true
          }
        },
        {
          "language_server": { "name": "ruff" }
        }
      ]
    }
  },
  "lsp": {
    "ruff": {
      "binary": {
        "path": "/Users/mikalbr/Documents/GitHub/backend/train/fastapi/starting/backend/venv/bin/ruff",
        "arguments": ["server"]
      }
    }
  }
}
